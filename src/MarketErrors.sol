pragma solidity 0.8.24;

/// @title Marketplace Custom Errors
/// @author Ali Nasirlou
/// @notice All custom errors used throughout the Marketplace.
library MarketErrors {
    /*//////////////////////////////////////////////////////////////
                            COMMON ERRORS
    //////////////////////////////////////////////////////////////*/

    error ZeroAddress();
    error ZeroPrice();
    error InvalidAmount();
    error InvalidDuration();

    /*//////////////////////////////////////////////////////////////
                            OWNERSHIP
    //////////////////////////////////////////////////////////////*/

    error NotOwner();
    error NotApproved();
    error NotOwnerNorApproved();

    /*//////////////////////////////////////////////////////////////
                            LISTINGS
    //////////////////////////////////////////////////////////////*/

    error AlreadyListed();
    error NotListed();

    /*//////////////////////////////////////////////////////////////
                            PURCHASE
    //////////////////////////////////////////////////////////////*/

    error PriceNotMet(uint256 required, uint256 sent);
    error SelfPurchase();
    error TransferFailed();

    /*//////////////////////////////////////////////////////////////
                            RENTALS
    //////////////////////////////////////////////////////////////*/

    error AlreadyRented();
    error RentalNotActive();
    error RentalStillActive();
    error CannotRentOwnNFT();

    /*//////////////////////////////////////////////////////////////
                            AUCTIONS
    //////////////////////////////////////////////////////////////*/

    error AuctionAlreadyExists();
    error AuctionNotFound();
    error AuctionAlreadyEnded();
    error AuctionStillRunning();
    error BidTooLow(uint256 currentBid);
    error AuctionAlreadyStarted();

    /*//////////////////////////////////////////////////////////////
                            OFFERS
    //////////////////////////////////////////////////////////////*/

    error OfferAlreadyExists();
    error OfferNotFound();
    error OfferExpired();

    /*//////////////////////////////////////////////////////////////
                            PAYMENTS
    //////////////////////////////////////////////////////////////*/

    error NoProceeds();

    /*//////////////////////////////////////////////////////////////
                            ADMIN
    //////////////////////////////////////////////////////////////*/

    error FeeTooHigh();
}
